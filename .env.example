# Copy to .env and edit
DB_HOST=localhost
DB_PORT=3306
DB_USER=postfix
DB_PASSWORD=changeme
DB_NAME=postfix

# Simple shared admin password (change this!)
ADMIN_PASSWORD=changeme

# Secret used to sign session cookies (change this!)
SESSION_SECRET=change-me-to-a-long-random-string

# Bind address / port
HOST=0.0.0.0
PORT=8080

# Optional HTTPS (leave empty for HTTP)
# Paths to your certificate and private key (PEM format)
SSL_CERTFILE=/etc/ssl/certs/your-domain.crt
SSL_KEYFILE=/etc/ssl/private/your-domain.key
# Optional: intermediate/chain if not included in the cert file
# SSL_CA_CERTS=/etc/ssl/certs/chain.pem
