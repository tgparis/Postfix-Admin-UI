[Unit]
Description=PostfixAdmin Lite
After=network.target mariadb.service
Wants=mariadb.service

[Service]
Type=simple
User=postfixadmin
Group=postfixadmin
WorkingDirectory=/opt/postfixadmin-lite
EnvironmentFile=/opt/postfixadmin-lite/.env
ExecStart=/opt/postfixadmin-lite/venv/bin/python -m uvicorn main:app \
  --host ${HOST:-127.0.0.1} \
  --port ${PORT:-8080} \
  --proxy-headers \
  --forwarded-allow-ips=* \
  --workers 2
Restart=on-failure
RestartSec=5
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/postfixadmin-lite
# If you run uvicorn with SSL directly (not recommended when using nginx):
# ReadOnlyPaths=/etc/ssl /etc/letsencrypt

[Install]
WantedBy=multi-user.target
